# Database
DATABASE_URL=postgresql://zegabytez:zegabytez_password_local@localhost:5432/zegabytez_mail

# Redis & Queues
REDIS_URL=redis://localhost:6379

# Fastify API Server
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=super_secret_better_auth_key_minimum_32_characters_long_for_dev
BETTER_AUTH_URL=http://localhost:4000

# Mailbox Password Master Encryption Key (32-byte hex for AES-256-GCM)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# cPanel / WHM Integration
CPANEL_HOST=mail.yourcpanelserver.com
CPANEL_PORT=2083
CPANEL_USERNAME=cpanel_user
CPANEL_API_TOKEN=CPANEL_API_TOKEN_HERE
CPANEL_SECURE=true

# WHMCS Integration
WHMCS_URL=https://cloud.zegabytez.com
WHMCS_API_IDENTIFIER=WHMCS_API_IDENTIFIER_HERE
WHMCS_API_SECRET=WHMCS_API_SECRET_HERE
WHMCS_INTERNAL_WEBHOOK_SECRET=super_secret_whmcs_webhook_token
