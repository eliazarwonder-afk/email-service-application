# ==============================================================================
# Zega Mail - Root Environment Variables Template (.env.example)
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth & Sessions
NEXTAUTH_SECRET=super_secret_zega_auth_encryption_key_minimum_64_chars_long_2026
SESSION_SECRET=super_secret_zega_auth_encryption_key_minimum_64_chars_long_2026
JWT_SECRET=super_secret_jwt_signing_key_32_characters_minimum_2026
NEXTAUTH_URL=http://localhost:3000
ENCRYPTION_MASTER_KEY=e4f9b2d89a710c53820fa49bebc8d01f54316ae82d1c9ef0a45bd7e812cb49ef

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# Admin System SMTP (Account Confirmation Codes & Transactional Mail)
SMTP_HOST=mail.zegacloud.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@zegacloud.com
SMTP_PASSWORD=your_secure_admin_smtp_password_here
SMTP_FROM_EMAIL=noreply@zegacloud.com
SMTP_FROM_NAME=ZegaCloud Security & Verification

# WHMCS Integration
WHMCS_API_URL=https://billing.zegacloud.com/includes/api.php
WHMCS_BASE_URL=https://billing.zegacloud.com
WHMCS_API_IDENTIFIER=your_whmcs_api_role_identifier
WHMCS_API_SECRET=your_whmcs_api_role_secret
WHMCS_CLIENT_SSO_SECRET=super_secret_whmcs_sso_shared_key
WHMCS_INTERNAL_WEBHOOK_SECRET=super_secret_whmcs_webhook_token

# cPanel / WHM Integration
CPANEL_HOST=mail.zegacloud.com
CPANEL_PORT=2083
CPANEL_USERNAME=cpanel_account_user
CPANEL_API_TOKEN=CPANEL_UAPI_TOKEN_HERE
CPANEL_SECURE=true

# Paystack (Nigeria & Africa)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signing_secret

# Flutterwave (Pan-Africa)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST_encryption_key_here
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_secret_hash

# Stripe (Global Cards USD/EUR/GBP)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Web3 Crypto
NEXT_PUBLIC_CRYPTO_MERCHANT_ADDRESS=TX7k1dZega9xMailTRC20Wallet88NVMe
CRYPTO_TRC20_WALLET=TX7k1dZega9xMailTRC20Wallet88NVMe
CRYPTO_BTC_WALLET=bc1qzega9xmailcloud77anycast001btc
CRYPTO_ETH_WALLET=0x71C2ega9xMailAnycastNVMeCluster8842
CRYPTO_SOL_WALLET=ZegaSoL9xMailAnycastClusterSolana99
TRONGRID_API_URL=https://api.trongrid.io
BLOCKSTREAM_API_URL=https://blockstream.info/api
ETH_RPC_URL=https://cloudflare-eth.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
CRON_SECRET=zegacloud-cron-secret
CRYPTO_VERIFICATION_MODE=auto_scanner
CRYPTO_MIN_CONFIRMATIONS=1
