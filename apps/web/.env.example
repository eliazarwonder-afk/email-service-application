# ==============================================================================
# Zega Mail - Complete Environment Configuration & Secrets Template
# ==============================================================================
# This file lists every secret, API key, and configuration variable needed to
# run Zega Mail in development and production.
# Copy this file to '.env.local' for local development or set in your Coolify /
# Docker container environment for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & BASE URLS
# ------------------------------------------------------------------------------
# NODE_ENV: 'development' | 'production' | 'test'
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
# Canonical public URL of your web application (used for OAuth callbacks and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SESSION, COOKIES & TOKEN SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign and encrypt session cookies (minimum 32-64 characters)
# Generate using: openssl rand -hex 32
NEXTAUTH_SECRET=super_secret_zega_auth_encryption_key_minimum_64_chars_long_2026
SESSION_SECRET=super_secret_zega_auth_encryption_key_minimum_64_chars_long_2026
JWT_SECRET=super_secret_jwt_signing_key_32_characters_minimum_2026
NEXTAUTH_URL=http://localhost:3000

# 32-byte hexadecimal master encryption key for AES-256-GCM mailbox password storage
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=e4f9b2d89a710c53820fa49bebc8d01f54316ae82d1c9ef0a45bd7e812cb49ef

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Google Sign-In & Sign-Up)
# ------------------------------------------------------------------------------
# Setup instructions:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized JavaScript Origins: http://localhost:3000 (and your production domain)
# 4. Add Authorized Redirect URIs:
#    - http://localhost:3000/api/auth/callback/google
#    - https://mail.zegacloud.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ------------------------------------------------------------------------------
# 4. GITHUB OAUTH (GitHub Sign-In & Sign-Up)
# ------------------------------------------------------------------------------
# Setup instructions:
# 1. Visit GitHub Settings > Developer settings > OAuth Apps: https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Set Homepage URL: http://localhost:3000
# 4. Set Authorization callback URL:
#    - http://localhost:3000/api/auth/callback/github
#    - https://mail.zegacloud.com/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# ------------------------------------------------------------------------------
# 5. ADMIN SYSTEM SMTP (Confirmation & Transactional Emails)
# ------------------------------------------------------------------------------
# Used by the application to send account confirmation 6-digit verification codes,
# password reset links, and automated billing invoices.
# (You can use cPanel Exim SMTP, AWS SES, SendGrid, Postmark, or Mailgun)
SMTP_HOST=mail.zegacloud.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@zegacloud.com
SMTP_PASSWORD=your_secure_admin_smtp_password_here
SMTP_FROM_EMAIL=noreply@zegacloud.com
SMTP_FROM_NAME=ZegaCloud Security & Verification

# ------------------------------------------------------------------------------
# 6. WHMCS BILLING & DOMAIN AUTOMATION API
# ------------------------------------------------------------------------------
# Used for real-time domain availability search, domain purchasing, invoice
# synchronization, and 1-Click Client SSO into billing.zegacloud.com
WHMCS_API_URL=https://billing.zegacloud.com/includes/api.php
WHMCS_BASE_URL=https://billing.zegacloud.com
WHMCS_API_IDENTIFIER=your_whmcs_api_role_identifier
WHMCS_API_SECRET=your_whmcs_api_role_secret
WHMCS_CLIENT_SSO_SECRET=super_secret_whmcs_sso_shared_key
WHMCS_INTERNAL_WEBHOOK_SECRET=super_secret_whmcs_webhook_token

# ------------------------------------------------------------------------------
# 7. CPANEL / WHM API (Exim/Dovecot Mailbox & DNS Automation)
# ------------------------------------------------------------------------------
# Used to automatically create mailboxes in Exim/Dovecot, set disk quotas,
# and retrieve DKIM, SPF, and MX records dynamically from cPanel DNS zone.
CPANEL_HOST=mail.zegacloud.com
CPANEL_PORT=2083
CPANEL_USERNAME=cpanel_account_user
CPANEL_API_TOKEN=CPANEL_UAPI_TOKEN_HERE
CPANEL_SECURE=true

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAY 1: PAYSTACK (Nigeria & Africa NGN/GHS/KES)
# ------------------------------------------------------------------------------
# Dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signing_secret

# ------------------------------------------------------------------------------
# 9. PAYMENT GATEWAY 2: FLUTTERWAVE (Pan-African Multi-Currency)
# ------------------------------------------------------------------------------
# Dashboard: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST_encryption_key_here
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_secret_hash

# ------------------------------------------------------------------------------
# 10. PAYMENT GATEWAY 3: STRIPE (Global Credit & Debit Cards in USD/EUR/GBP)
# ------------------------------------------------------------------------------
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ------------------------------------------------------------------------------
# 11. PAYMENT GATEWAY 4: WEB3 & CRYPTOCURRENCY (Non-Custodial)
# ------------------------------------------------------------------------------
# Receiving merchant wallet addresses displayed to clients on invoices & QR codes
NEXT_PUBLIC_CRYPTO_MERCHANT_ADDRESS=TX7k1dZega9xMailTRC20Wallet88NVMe
CRYPTO_TRC20_WALLET=TX7k1dZega9xMailTRC20Wallet88NVMe
CRYPTO_BTC_WALLET=bc1qzega9xmailcloud77anycast001btc
CRYPTO_ETH_WALLET=0x71C2ega9xMailAnycastNVMeCluster8842
CRYPTO_SOL_WALLET=ZegaSoL9xMailAnycastClusterSolana99

# External Public RPC Nodes for automated on-chain scanner verification
TRONGRID_API_URL=https://api.trongrid.io
BLOCKSTREAM_API_URL=https://blockstream.info/api
ETH_RPC_URL=https://cloudflare-eth.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Cron scanner execution secret (used to trigger /api/cron/crypto-scanner)
CRON_SECRET=zegacloud-cron-secret
CRYPTO_VERIFICATION_MODE=auto_scanner
CRYPTO_MIN_CONFIRMATIONS=1
