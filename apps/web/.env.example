# ==============================================================================
# ZegaMail - Web Application Environment Configuration Template
# ==============================================================================
# Note: All customer payments, subscriptions, and invoice settlements are
# handled directly by WHMCS (billing.zegacloud.com). This web application does
# NOT handle or store payment gateway credentials (Paystack, Stripe, Crypto).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & BASE URLS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SESSION, COOKIES & TOKEN SECURITY
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=super_secret_zega_auth_encryption_key_minimum_64_chars_long_2026
SESSION_SECRET=super_secret_zega_auth_encryption_key_minimum_64_chars_long_2026
JWT_SECRET=super_secret_jwt_signing_key_32_characters_minimum_2026
NEXTAUTH_URL=http://localhost:3000
ENCRYPTION_MASTER_KEY=e4f9b2d89a710c53820fa49bebc8d01f54316ae82d1c9ef0a45bd7e812cb49ef

# ------------------------------------------------------------------------------
# 3. ADMIN SYSTEM SMTP (Confirmation & Transactional Emails)
# ------------------------------------------------------------------------------
SMTP_HOST=mail.zegacloud.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@zegacloud.com
SMTP_PASSWORD=your_secure_admin_smtp_password_here
SMTP_FROM_EMAIL=noreply@zegacloud.com
SMTP_FROM_NAME=ZegaCloud Security & Verification

# ------------------------------------------------------------------------------
# 4. WHMCS BILLING & DOMAIN AUTOMATION API
# ------------------------------------------------------------------------------
# Used for real-time domain availability search, domain purchasing, and
# 1-Click Client SSO into panel.zegacloud.com
WHMCS_API_URL=https://panel.zegacloud.com/includes/api.php
WHMCS_BASE_URL=https://panel.zegacloud.com
NEXT_PUBLIC_WHMCS_BASE_URL=https://panel.zegacloud.com
WHMCS_API_IDENTIFIER=your_whmcs_api_role_identifier
WHMCS_API_SECRET=your_whmcs_api_role_secret
WHMCS_CLIENT_SSO_SECRET=super_secret_whmcs_sso_shared_key
WHMCS_INTERNAL_WEBHOOK_SECRET=super_secret_whmcs_webhook_token

# ------------------------------------------------------------------------------
# 5. CLOUD MAIL CLUSTER (Exim / Dovecot Mailbox & DNS Automation)
# ------------------------------------------------------------------------------
CPANEL_HOST=mail.zegacloud.com
CPANEL_PORT=2083
CPANEL_USERNAME=cpanel_account_user
CPANEL_API_TOKEN=CPANEL_UAPI_TOKEN_HERE
CPANEL_SECURE=true
