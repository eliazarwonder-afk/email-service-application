# ==============================================================================
# ZegaMail Production Environment Configuration (.env.production)
# ==============================================================================
# All payment processing (Paystack, Stripe, Flutterwave, Crypto) is handled
# directly by WHMCS (billing.zegacloud.com). No payment gateway credentials
# are required in this web application.
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=https://mail.zegacloud.com

# 1. PostgreSQL Database & Redis (Dedicated Containers on Coolify / Docker)
DATABASE_URL=postgresql://zegabytez:zegabytez_secure_pass@postgres:5432/zegabytez_mail
REDIS_URL=redis://redis:6379

# 2. Cloud Mail Gateway Bridge
CPANEL_CLUSTER_HOST=mail.zegacloud.com
CPANEL_SMTP_PORT=465
CPANEL_SMTP_SECURE=true
CPANEL_FALLBACK_USER=
CPANEL_FALLBACK_PASS=

# 3. WHMCS Internal Webhook & Cluster Secret
# Must match 'api_secret' in WHMCS Addon Module (modules/addons/zegabytezmail_addon)
WHMCS_INTERNAL_WEBHOOK_SECRET=super_secret_whmcs_webhook_token
WHMCS_BASE_URL=https://billing.zegacloud.com
WHMCS_API_URL=https://billing.zegacloud.com/includes/api.php
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
WHMCS_CLIENT_SSO_SECRET=super_secret_whmcs_sso_shared_key

# 4. Session Security & Encryption Master Key
SESSION_SECRET=production_random_64_byte_crypto_key_here
JWT_SECRET=production_jwt_signing_key_32_characters_minimum_2026
ENCRYPTION_MASTER_KEY=production_32_byte_hex_encryption_master_key

# 5. Database Admin UI (PgAdmin 4)
PGADMIN_DEFAULT_EMAIL=admin@zegacloud.com
PGADMIN_DEFAULT_PASSWORD=admin_password_local
