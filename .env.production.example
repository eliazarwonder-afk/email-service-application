# ==============================================================================
# ZegaMail Production Environment Configuration (.env.production)
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=https://mail.zegacloud.com

# 1. PostgreSQL Database (Dedicated Container on Coolify)
# Connects to the bundled postgres:16-alpine container
DATABASE_URL=postgresql://zegabytez:zegabytez_secure_pass@postgres:5432/zegabytez_mail

# Redis Caching & Queue Worker (Optional on Coolify)
REDIS_URL=redis://redis:6379

# 2. Direct cPanel Exim/Dovecot Mail Gateway Bridge
# Direct TLS 1.3 SMTP (Port 465 / 587) with RFC 3461 DSN delivery notifications
CPANEL_CLUSTER_HOST=mail.zegacloud.com
CPANEL_SMTP_PORT=465
CPANEL_SMTP_SECURE=true
CPANEL_FALLBACK_USER=
CPANEL_FALLBACK_PASS=

# 3. WHMCS Internal Webhook & Cluster Secret
# Must match 'api_secret' in WHMCS Addon Module (modules/addons/zegabytezmail_addon)
WHMCS_INTERNAL_WEBHOOK_SECRET=super_secret_whmcs_webhook_token
WHMCS_BASE_URL=https://billing.zegacloud.com

# 4. Crypto Verification Mode & On-Chain Background Scanner
# Mode: "auto_scanner" (Automated On-Chain Scanner + Manual Override) or "manual_only"
CRYPTO_VERIFICATION_MODE=auto_scanner
CRON_SECRET=zegacloud-cron-secret
CRYPTO_MIN_CONFIRMATIONS=1

# Receiving Wallets (Managed in WHMCS Module Admin)
CRYPTO_TRC20_WALLET=TX7k1dZega9xMailTRC20Wallet88NVMe
CRYPTO_BTC_WALLET=bc1qzega9xmailcloud77anycast001btc
CRYPTO_ETH_WALLET=0x71C2ega9xMailAnycastNVMeCluster8842
CRYPTO_SOL_WALLET=ZegaSoL9xMailAnycastClusterSolana99

# External Public RPCs for On-Chain Verification
TRONGRID_API_URL=https://api.trongrid.io
BLOCKSTREAM_API_URL=https://blockstream.info/api
ETH_RPC_URL=https://cloudflare-eth.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Session Security
SESSION_SECRET=production_random_64_byte_crypto_key_here
