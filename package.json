{
  "name": "zegabytez-mail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @zegabytez/api dev",
    "dev:worker": "pnpm --filter @zegabytez/worker dev",
    "dev:web": "pnpm --filter @zegabytez/web dev",
    "tunnel": "node scripts/dev-mobile.js",
    "dev:mobile": "node scripts/dev-mobile.js",
    "db:generate": "pnpm --filter @zegabytez/database db:generate",
    "db:migrate": "pnpm --filter @zegabytez/database db:migrate",
    "db:push": "pnpm --filter @zegabytez/database db:push",
    "db:studio": "pnpm --filter @zegabytez/database db:studio",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "dotenv": "^16.6.1",
    "localtunnel": "^2.0.2",
    "playwright": "^1.64.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
